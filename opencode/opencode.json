{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "build": {
      "model": "opencode-go/qwen4-max"
    },
    "operative-runner": {
      "description": "Executes operational and mechanical tasks: file edits, refactors, scripts, bulk changes. Use it for well-specified work that does not need deep analysis.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "plan": {
      "model": "opencode-go/qwen4-max"
    }
  },
  "lsp": {},
  "permissions": [
    { "action": "skill", "resource": "pausa-*", "effect": "deny" },
    { "action": "skill", "resource": "*-pausa", "effect": "deny" },
    { "action": "skill", "resource": "ticket-pausa", "effect": "allow" }
  ],
  "permission": {
    "*": "allow",
    "skill": {
      "docs": "deny",
      "computer-use": "deny",
      "chrome-browser": "deny",
      "artifact-emulator": "deny",
      "deep-research": "deny",
      "c-review": "deny",
      "canvas-design": "deny",
      "find-skills": "deny"
    },
    "bash": {
      "*": "allow",
      "rm /tmp*": "allow",
      "rm *": "ask",
      "mv *": "ask",
      "dd *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "* | sh": "ask",
      "* | bash": "ask",
      "reboot": "ask",
      "shutdown": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "mkfs *": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "format *": "ask",
      "npm run publish": "ask",
      "brew install *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "* /tmp/*": "allow",
      "* /tmp": "allow",
      "*/tmp/*": "allow",
      "/tmp/*": "allow"
    },
    "doom_loop": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow"
    }
  },
  "plugins": [
    "@slkiser/opencode-quota"
  ],
  "provider": {
    "anthropic": {},
    "deepseek": {},
    "opencode-go": {},
    "opencode": {}
  }
}
