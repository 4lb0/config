#!/usr/bin/env python3
"""sessions-ls — list terminal coding agents running in tmux panes.

Shows every opencode / claude process that owns a tmux pane, with its session
name, its status (working / awaiting / approval) and where it lives.

Interactive picker (when stdout and stdin are a TTY): arrows/jk to move,
1-9 and 0 to jump straight to one of the first ten rows, / to filter,
Enter to jump to that pane, q to quit. The list refreshes itself every second.

In a pipeline (or with --plain) it prints an ``ls -lht``-ish listing sorted by
most recently active, one row per agent, and exits.

Only the Python standard library is used.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import shutil
import sqlite3
import subprocess
import sys
import termios
import time
import tty
import unicodedata
from datetime import datetime, timezone
from dataclasses import dataclass

VERSION = "0.5.0"

HOME = os.path.expanduser("~")
OPENCODE_DB = os.environ.get(
    "SESSION_LS_OPENCODE_DB", os.path.join(HOME, ".local/share/opencode/opencode.db")
)
CLAUDE_PROJECTS = os.environ.get(
    "SESSION_LS_CLAUDE_DIR", os.path.join(HOME, ".claude/projects")
)

SEP = "\x1f"
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

# Shortcuts for the first ten rows: 1-9 and 0 for the tenth.
HOTKEYS = "1234567890"

# Used when the terminal is too narrow for the full status word.
STATUS_SHORT = {
    "working": "wor",
    "awaiting": "awa",
    "question": "ask",
    "approval": "app",
    "unknown": "unk",
}

# Subcommands / flags that mean "not an interactive TUI".
OPENCODE_NON_TUI = {
    "acp", "api", "auth", "debug", "mcp", "models", "plugin", "pair", "reload",
    "run", "serve", "service", "session", "stats", "uninstall", "update", "upgrade",
}
CLAUDE_NON_TUI = {
    "-p", "--print", "--version", "-v", "mcp", "doctor", "update", "install",
    "config", "setup-token",
}

SKIP_TYPES = {
    "mode", "permission-mode", "session-owner", "file-history-snapshot", "summary",
    "queue-operation", "atis-latch", "attachment", "api-request", "last-prompt",
}

APPROVAL_RE = re.compile(
    r"(Do you want to (?:proceed|allow|run|make|execute)"
    r"|Permission required"
    r"|Allow (?:once|always|this)"
    r"|❯\s*1[.)]\s*Yes"
    r"|\(y/n\)|\[y/N\])",
    re.IGNORECASE,
)

QUESTION_RE = re.compile(
    r"(Enter to select"          # Claude Code's question tool
    r"|enter submit"             # OpenCode's question panel
    r"|Type your own answer)",   # OpenCode free-form option
    re.IGNORECASE,
)

STATUS_COLORS = {
    "working": "\x1b[32m",
    "awaiting": "\x1b[33m",
    "question": "\x1b[36m",
    "approval": "\x1b[1;31m",
    "unknown": "\x1b[2m",
}
RESET = "\x1b[0m"
DIM = "\x1b[2m"
BOLD = "\x1b[1m"


# --------------------------------------------------------------------------
# shell helpers
# --------------------------------------------------------------------------

def run(cmd: list[str]) -> str:
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return out.stdout if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def tmux(*args: str) -> str:
    return run(["tmux", *args])


# --------------------------------------------------------------------------
# data model
# --------------------------------------------------------------------------

@dataclass
class Pane:
    pane_id: str
    session: str
    window: int
    index: int
    pid: int
    command: str
    title: str
    path: str
    active: bool

    @property
    def target(self) -> str:
        return f"{self.session}:{self.window}.{self.index}"


@dataclass
class Agent:
    pane: Pane
    kind: str
    name: str
    status: str
    activity: float          # epoch seconds of last observed activity
    session_id: str = ""
    confirmed: bool = True   # False when the session was guessed


@dataclass
class Proc:
    pid: int
    ppid: int
    argv: list[str]
    started: float = 0.0


# --------------------------------------------------------------------------
# tmux
# --------------------------------------------------------------------------

def list_panes() -> list[Pane]:
    fmt = SEP.join([
        "#{pane_id}", "#{session_name}", "#{window_index}", "#{pane_index}",
        "#{pane_pid}", "#{pane_current_command}", "#{pane_title}",
        "#{pane_current_path}", "#{pane_active}",
    ])
    panes = []
    for line in tmux("list-panes", "-a", "-F", fmt).splitlines():
        parts = line.split(SEP)
        if len(parts) < 9:
            continue
        pane_id, sess, win, idx, pid, cmd, title, path, active = parts[:9]
        try:
            panes.append(Pane(
                pane_id=pane_id, session=sess, window=int(win), index=int(idx),
                pid=int(pid), command=cmd, title=title, path=path,
                active=active == "1",
            ))
        except ValueError:
            continue
    return panes


def pane_prompt(pane_id: str) -> str:
    """Last lines of a pane, used to spot an approval prompt."""
    out = tmux("capture-pane", "-p", "-t", pane_id, "-S", "-12")
    lines = [ln for ln in out.splitlines() if ln.strip()]
    return "\n".join(lines[-10:])


# --------------------------------------------------------------------------
# processes
# --------------------------------------------------------------------------

def parse_ps_time(text: str) -> float:
    """Epoch for a ``ps -o lstart`` value (local time)."""
    try:
        return time.mktime(time.strptime(text, "%a %b %d %H:%M:%S %Y"))
    except (ValueError, OverflowError):
        return 0.0


def list_processes() -> dict[int, Proc]:
    procs: dict[int, Proc] = {}
    for line in run(["ps", "-eo", "pid=,ppid=,lstart=,command="]).splitlines():
        parts = line.strip().split(None, 7)
        if len(parts) < 8:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        procs[pid] = Proc(pid=pid, ppid=ppid, argv=parts[7].split(),
                          started=parse_ps_time(" ".join(parts[2:7])))
    return procs


def looks_like_tui(proc: Proc) -> bool:
    argv = proc.argv
    base = os.path.basename(argv[0])
    args = argv[1:]
    # Never match the helper daemons / non interactive invocations.
    if "serve" in args or "daemon" in args or "pty" in " ".join(args):
        return False
    if base == "opencode":
        return not any(a in OPENCODE_NON_TUI for a in args if not a.startswith("-"))
    if base == "claude":
        return not any(a in CLAUDE_NON_TUI for a in args)
    return False


def pane_env_map(pids: list[int]) -> dict[int, str]:
    """pid -> TMUX_PANE via the process environment."""
    if not pids:
        return {}
    out = run(["ps", "eww", "-o", "pid=,command=", "-p", ",".join(map(str, pids))])
    found: dict[int, str] = {}
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s", line)
        if not m:
            continue
        pid = int(m.group(1))
        hit = re.search(r"TMUX_PANE=(%\d+)", line)
        if hit:
            found[pid] = hit.group(1)
    return found


def ancestor_pane(proc: Proc, procs: dict[int, Proc], pane_of_pid: dict[int, Pane]) -> Pane | None:
    pid, seen = proc.pid, 0
    while pid in procs and seen < 20:
        if pid in pane_of_pid:
            return pane_of_pid[pid]
        pid = procs[pid].ppid
        seen += 1
    return None


def agents_in_panes(panes: list[Pane]) -> list[tuple[Pane, str, Proc]]:
    procs = list_processes()
    pane_of_pid = {p.pid: p for p in panes}
    pane_of_id = {p.pane_id: p for p in panes}
    candidates = [p for p in procs.values() if looks_like_tui(p)]

    matched: dict[str, tuple[int, int, Proc]] = {}
    orphan: list[Proc] = []
    for proc in candidates:
        pane = ancestor_pane(proc, procs, pane_of_pid)
        if pane is None:
            orphan.append(proc)
            continue
        score = (0, 0 if len(proc.argv) == 1 else 1)
        prev = matched.get(pane.pane_id)
        if prev is None or score < prev[:2]:
            matched[pane.pane_id] = (*score, proc)

    # Fall back to TMUX_PANE for agents whose ancestry was detached.
    env = pane_env_map([p.pid for p in orphan])
    for proc in orphan:
        pane = pane_of_id.get(env.get(proc.pid, ""))
        if pane is None:
            continue
        score = (1, 0 if len(proc.argv) == 1 else 1)
        prev = matched.get(pane.pane_id)
        if prev is None or score < prev[:2]:
            matched[pane.pane_id] = (*score, proc)

    return [(pane_of_id[pane_id], os.path.basename(entry[2].argv[0]), entry[2])
            for pane_id, entry in matched.items()]


# --------------------------------------------------------------------------
# opencode sessions
# --------------------------------------------------------------------------

def norm(s: str) -> str:
    return re.sub(r"\s+", " ", s or "").strip().casefold()


class OpenCodeIndex:
    def __init__(self, db_path: str = OPENCODE_DB):
        self.db_path = db_path
        self.conn: sqlite3.Connection | None = None
        self.sessions: list[dict] = []
        self.loaded_at = 0.0

    def _connect(self) -> sqlite3.Connection | None:
        if self.conn is not None:
            return self.conn
        if not os.path.exists(self.db_path):
            return None
        try:
            conn = sqlite3.connect(
                f"file:{self.db_path}?mode=ro", uri=True, timeout=2.0
            )
            conn.row_factory = sqlite3.Row
            conn.execute("PRAGMA query_only=1")
            self.conn = conn
        except sqlite3.Error:
            return None
        return self.conn

    def refresh(self, max_age: float = 1.0) -> None:
        if time.time() - self.loaded_at < max_age and self.sessions:
            return
        conn = self._connect()
        if conn is None:
            return
        try:
            # Roots plus their whole subtree: a session whose subagent is
            # still running is working even if the root turn is idle.
            rows = conn.execute(
                """
                WITH RECURSIVE roots AS (
                    SELECT id, title, slug, directory, time_created,
                           time_updated, time_busy, time_idle, idle_outcome,
                           time_viewed, parent_id
                    FROM session_v2
                    WHERE parent_id IS NULL AND time_archived IS NULL
                    ORDER BY time_updated DESC
                    LIMIT 500
                ), tree(root_id, id, parent_id, title, slug, directory,
                        time_created, time_updated, time_busy, time_idle,
                        idle_outcome, time_viewed) AS (
                    SELECT id, id, parent_id, title, slug, directory,
                           time_created, time_updated, time_busy, time_idle,
                           idle_outcome, time_viewed
                    FROM roots
                    UNION ALL
                    SELECT tree.root_id, s.id, s.parent_id, s.title, s.slug,
                           s.directory, s.time_created, s.time_updated,
                           s.time_busy, s.time_idle, s.idle_outcome,
                           s.time_viewed
                    FROM session_v2 s JOIN tree ON s.parent_id = tree.id
                    WHERE s.time_archived IS NULL
                )
                SELECT * FROM tree
                """
            ).fetchall()
        except sqlite3.Error:
            # Schema may differ; fall back to the legacy table.
            try:
                rows = conn.execute(
                    """
                    SELECT id AS root_id, id, parent_id, title, slug, directory,
                           time_created, time_updated, NULL AS time_busy,
                           NULL AS time_idle, NULL AS idle_outcome,
                           NULL AS time_viewed
                    FROM session
                    WHERE parent_id IS NULL AND time_archived IS NULL
                    ORDER BY time_updated DESC LIMIT 500
                    """
                ).fetchall()
            except sqlite3.Error:
                return

        now = time.time()
        roots: list[dict] = []
        children: dict[str, list[dict]] = {}
        for row in rows:
            entry = dict(row)
            root_id = entry.pop("root_id", entry["id"])
            if root_id == entry["id"]:
                roots.append(entry)
            else:
                children.setdefault(root_id, []).append(entry)
        for root in roots:
            family = [root, *children.get(root["id"], [])]
            root["status"] = (
                "working"
                if any(opencode_status(s, now) == "working" for s in family)
                else "awaiting"
            )
            root["activity"] = max(opencode_activity(s) for s in family)
            root["created"] = (root.get("time_created") or 0) / 1000.0
        self.sessions = roots
        self.loaded_at = now

    def local(self, directory: str) -> list[dict]:
        """Top level sessions started in *directory*, most recently used first."""
        directory = os.path.normpath(directory)
        hits = [s for s in self.sessions
                if os.path.normpath(s.get("directory") or "") == directory]
        hits.sort(key=lambda s: (s.get("time_viewed") or 0,
                                 s.get("time_updated") or 0), reverse=True)
        return hits



def opencode_status(s: dict, now: float) -> str:
    busy = s.get("time_busy") or 0
    idle = s.get("time_idle") or 0
    if busy and busy > idle:
        # Guard against a stale "busy" flag left by a crash.
        last = max(busy, s.get("time_updated") or 0) / 1000.0
        return "working" if now - last < 2 * 3600 else "awaiting"
    return "awaiting"


def opencode_activity(s: dict) -> float:
    for key in ("time_updated", "time_busy", "time_idle", "time_created"):
        v = s.get(key)
        if v:
            return v / 1000.0
    return 0.0


# --------------------------------------------------------------------------
# claude sessions
# --------------------------------------------------------------------------

def claude_project_dir(path: str) -> str | None:
    def munge(p: str) -> str:
        return re.sub(r"[^A-Za-z0-9_]", "-", p)

    p = os.path.normpath(path)
    while True:
        cand = os.path.join(CLAUDE_PROJECTS, munge(p))
        if os.path.isdir(cand):
            return cand
        if p == "/" or not p:
            return None
        p = os.path.dirname(p)


class ClaudeIndex:
    """Reads the tail of recent transcripts and derives title + status."""

    MAX_BYTES = 256 * 1024

    def __init__(self):
        self.cache: dict[str, tuple[tuple, dict]] = {}

    def _tail(self, path: str) -> list[str]:
        try:
            size = os.path.getsize(path)
            with open(path, "rb") as fh:
                if size > self.MAX_BYTES:
                    fh.seek(size - self.MAX_BYTES)
                    chunk = fh.read()
                    lines = chunk.decode("utf-8", "replace").splitlines()[1:]
                else:
                    lines = fh.read().decode("utf-8", "replace").splitlines()
            return lines
        except OSError:
            return []

    def info(self, path: str) -> dict:
        try:
            st = os.stat(path)
        except OSError:
            return {}
        key = (st.st_mtime_ns, st.st_size)
        cached = self.cache.get(path)
        if cached is not None and cached[0] == key:
            return cached[1]

        title = ""
        status = ""
        activity = st.st_mtime
        last_ts = 0.0
        for line in reversed(self._tail(path)):
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(entry, dict):
                continue
            etype = entry.get("type")
            if last_ts == 0.0 and entry.get("timestamp"):
                last_ts = parse_iso(entry["timestamp"])
                activity = last_ts or activity
            if not title and etype == "ai-title":
                title = entry.get("aiTitle") or ""
                continue
            if status:
                # Keep walking back only to find the title: it is usually
                # written before the latest turn entry.
                continue
            if etype in SKIP_TYPES:
                continue
            if etype == "assistant":
                stop = (entry.get("message") or {}).get("stop_reason")
                status = "working" if stop in (None, "tool_use") else "awaiting"
            elif etype == "user":
                status = "working"
            elif etype == "system":
                sub = entry.get("subtype")
                status = "working" if sub in ("compact_boundary",) else "awaiting"
            elif etype in ("progress", "tool_result", "tool_use"):
                status = "working"
            # Anything else (plugin bookkeeping, ledger entries…) is ignored.

        if not status:
            status = "working" if time.time() - st.st_mtime < 90 else "awaiting"
        elif status == "working" and time.time() - activity > 2 * 3600:
            # A "working" flag left behind by a killed or abandoned turn.
            status = "awaiting"

        data = {
            "title": title,
            "status": status,
            "activity": activity,
            "created": getattr(st, "st_birthtime", 0.0) or st.st_mtime,
            "mtime": st.st_mtime,
            "size": st.st_size,
            "id": os.path.basename(path).removesuffix(".jsonl"),
        }
        self.cache[path] = (key, data)
        return data

    def recent(self, project_dir: str, limit: int = 12) -> list[tuple[str, dict]]:
        try:
            names = [n for n in os.listdir(project_dir) if n.endswith(".jsonl")]
        except OSError:
            return []
        paths = [os.path.join(project_dir, n) for n in names]
        paths.sort(key=lambda p: stat_mtime(p), reverse=True)
        out = []
        for p in paths[:limit]:
            info = self.info(p)
            if info:
                out.append((p, info))
        return out

    def candidates(self, project_dir: str) -> list[dict]:
        return [
            {
                "id": info["id"],
                "title": info.get("title") or "",
                "status": info.get("status") or "awaiting",
                "activity": info.get("activity") or 0.0,
                "created": info.get("created") or 0.0,
            }
            for _path, info in self.recent(project_dir)
        ]


def stat_mtime(path: str) -> float:
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def parse_iso(ts: str) -> float:
    try:
        dt = datetime.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")
    except (ValueError, TypeError):
        return 0.0
    return dt.replace(tzinfo=timezone.utc).timestamp()


# --------------------------------------------------------------------------
# collection
# --------------------------------------------------------------------------

def pane_hint(kind: str, title: str) -> str:
    """Session title advertised by the pane title, or "" when it has none."""
    title = title or ""
    if kind == "opencode":
        for prefix in ("OC | ", "OC |"):
            if title.startswith(prefix):
                return title[len(prefix):].strip()
        return ""
    hint = re.sub(r"^[^\w]+", "", title).strip()
    return "" if hint in ("", "Claude Code") else hint


def hint_matches(title: str, hint: str) -> bool:
    title = norm(title)
    if not title:
        return False
    if hint.rstrip().endswith(("…", "...")):
        return title.startswith(norm(hint.rstrip().rstrip(".…")))
    return title == norm(hint)


def session_arg(proc: Proc, kind: str) -> str:
    """Session id passed explicitly on the agent command line."""
    flags = ("-s", "--session") if kind == "opencode" else \
        ("-r", "--resume", "--session-id")
    argv = proc.argv[1:]
    for i, arg in enumerate(argv):
        for flag in flags:
            if (arg == flag and i + 1 < len(argv)
                    and not argv[i + 1].startswith("-")):
                return argv[i + 1]
            if arg.startswith(flag + "="):
                return arg[len(flag) + 1:]
    return ""


def match_group(members: list[tuple[Pane, Proc]], kind: str,
                local: list[dict], everything: list[dict],
                used: set[str] | None = None
                ) -> dict[str, tuple[dict | None, bool]]:
    """Pair panes with sessions, never handing out the same session twice.

    Strong signals first (``-s``/``--resume`` on the command line, then the
    title in the pane title); panes left without a title get a session created
    after their agent process started, so a brand new session in a directory
    does not inherit the name and status of an older one.
    """
    out: dict[str, tuple[dict | None, bool]] = {}
    used = used if used is not None else set()
    pending: list[tuple[Pane, Proc]] = []
    for pane, proc in members:
        sid = session_arg(proc, kind)
        hit = next((c for c in everything if sid and c["id"] == sid), None)
        if hit is not None and hit["id"] not in used:
            out[pane.pane_id] = (hit, True)
            used.add(hit["id"])
        else:
            pending.append((pane, proc))

    unmatched: list[tuple[Pane, Proc, str]] = []
    for pane, proc in pending:
        hint = pane_hint(kind, pane.title)
        hit = None
        if hint:
            for pool in (local, everything):
                hit = next((c for c in pool
                            if c["id"] not in used
                            and hint_matches(c.get("title") or "", hint)), None)
                if hit is not None:
                    break
        if hit is not None:
            out[pane.pane_id] = (hit, True)
            used.add(hit["id"])
        else:
            unmatched.append((pane, proc, hint))

    # Untitled panes: the session must have been created after the agent was
    # launched, otherwise it belongs to some other pane (or to the past).
    pairs = []
    for pane, proc, hint in unmatched:
        if hint or not proc.started:
            continue
        for cand in local:
            created = cand.get("created") or 0
            if cand["id"] in used or not created:
                continue
            if created < proc.started - 5:
                continue
            pairs.append((abs(created - proc.started), pane.pane_id, cand))
    pairs.sort(key=lambda p: p[0])
    for _delta, pane_id, cand in pairs:
        if pane_id in out or cand["id"] in used:
            continue
        out[pane_id] = (cand, False)
        used.add(cand["id"])

    # A title that did not match the index (renamed, or the database lagged):
    # keep showing the newest free session in that directory.
    for pane, _proc, hint in unmatched:
        if pane.pane_id in out or not hint:
            continue
        rest = [c for c in local if c["id"] not in used]
        if rest:
            out[pane.pane_id] = (rest[0], False)
            used.add(rest[0]["id"])

    for pane, _proc, _hint in unmatched:
        out.setdefault(pane.pane_id, (None, False))
    return out


def collect(opencode: OpenCodeIndex, claude: ClaudeIndex) -> list[Agent]:
    opencode.refresh()
    panes = agents_in_panes(list_panes())

    groups: dict[tuple[str, str], list[tuple[Pane, Proc]]] = {}
    for pane, kind, proc in panes:
        groups.setdefault((kind, os.path.normpath(pane.path or os.getcwd())),
                          []).append((pane, proc))

    matched: dict[str, tuple[dict | None, bool]] = {}
    claimed: set[str] = set()
    for (kind, directory), members in groups.items():
        if kind == "opencode":
            local = opencode.local(directory)
            matched.update(match_group(members, kind, local, opencode.sessions,
                                       claimed))
        else:
            project = claude_project_dir(directory)
            local = claude.candidates(project) if project else []
            matched.update(match_group(members, kind, local, local, claimed))

    agents: list[Agent] = []
    for pane, kind, proc in panes:
        pdir = pane.path or os.getcwd()
        hint = pane_hint(kind, pane.title)
        session, confirmed = matched.get(pane.pane_id, (None, False))

        if session is not None:
            name = (session.get("title") or hint or session.get("slug")
                    or "new session")
            status = session.get("status") or "awaiting"
            activity = session.get("activity") or 0.0
            sid = session.get("id") or ""
        else:
            name = hint or "new session"
            status = "unknown"
            activity = proc.started or stat_mtime(pdir)
            sid = ""

        agents.append(Agent(
            pane=pane, kind=kind, name=name, status=status,
            activity=activity, session_id=sid, confirmed=confirmed,
        ))

    # Interactive dialogs outrank "working"/"unknown": a visible permission
    # prompt or question means the agent is blocked waiting for the user.
    for agent in agents:
        if agent.status in ("working", "unknown"):
            prompt = pane_prompt(agent.pane.pane_id)
            if not prompt:
                continue
            if APPROVAL_RE.search(prompt):
                agent.status = "approval"
            elif QUESTION_RE.search(prompt):
                agent.status = "question"

    agents.sort(key=lambda a: (a.activity or 0), reverse=True)
    return agents


# --------------------------------------------------------------------------
# formatting
# --------------------------------------------------------------------------

def human_age(ts: float, now: float | None = None) -> str:
    if not ts:
        return "?"
    now = now or time.time()
    delta = max(0.0, now - ts)
    if delta < 10:
        return "now"
    if delta < 60:
        return f"{int(delta)}s"
    if delta < 3600:
        return f"{int(delta / 60)}m"
    if delta < 86400:
        return f"{int(delta / 3600)}h"
    return f"{int(delta / 86400)}d"


def short_path(path: str) -> str:
    if path == HOME:
        return "~"
    if path.startswith(HOME + "/"):
        return "~" + path[len(HOME):]
    return path


ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text)


def cell_width(text: str) -> int:
    """Display width in terminal cells (wide CJK glyphs take two)."""
    width = 0
    for ch in text:
        if unicodedata.combining(ch):
            continue
        width += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return width


def truncate(text: str, width: int) -> str:
    if width <= 0:
        return ""
    if cell_width(text) <= width:
        return text
    if width == 1:
        return "…"
    out: list[str] = []
    used = 0
    for ch in text:
        w = cell_width(ch)
        if used + w > width - 1:
            break
        out.append(ch)
        used += w
    return "".join(out) + "…"


def truncate_left(text: str, width: int) -> str:
    """Keep the tail of *text*, prefixing an ellipsis when it does not fit."""
    if width <= 0:
        return ""
    if cell_width(text) <= width:
        return text
    if width == 1:
        return "…"
    out: list[str] = []
    used = 0
    for ch in reversed(text):
        w = cell_width(ch)
        if used + w > width - 1:
            break
        out.append(ch)
        used += w
    return "…" + "".join(reversed(out))


def pad(text: str, width: int) -> str:
    """Pad *text* (assumed ANSI-free) with spaces up to *width* cells."""
    return text + " " * max(0, width - cell_width(text))


def plain(agents: list[Agent], header: bool = False, color: bool | None = None) -> str:
    if not agents:
        return ""
    if color is None:
        color = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
    now = time.time()
    rows = [
        [a.status, a.kind, a.pane.target, human_age(a.activity, now), a.name,
         short_path(a.pane.path)]
        for a in agents
    ]
    labels = ["STATUS", "AGENT", "TMUX", "ACTIVE", "NAME", "PATH"]
    all_rows = ([labels] if header else []) + rows
    widths = [max(len(r[i]) for r in all_rows) for i in range(4)]
    lines = []
    if header:
        lines.append(
            labels[0].ljust(widths[0] + 1) + labels[1].ljust(widths[1] + 1)
            + labels[2].ljust(widths[2] + 1) + labels[3].ljust(widths[3])
            + "  " + labels[4]
        )
    for r in rows:
        status = r[0].ljust(widths[0] + 1)
        if color:
            status = STATUS_COLORS.get(r[0], "") + status + RESET
        line = (
            status + r[1].ljust(widths[1] + 1)
            + r[2].ljust(widths[2] + 1) + r[3].ljust(widths[3]) + "  " + r[4]
        )
        if r[5]:
            path = DIM + r[5] + RESET if color else r[5]
            line += "  " + path
        lines.append(line.rstrip())
    return "\n".join(lines)


def as_json(agents: list[Agent]) -> str:
    return json.dumps([
        {
            "kind": a.kind,
            "status": a.status,
            "name": a.name,
            "path": a.pane.path,
            "tmux": {
                "pane": a.pane.pane_id,
                "session": a.pane.session,
                "window": a.pane.window,
                "index": a.pane.index,
                "target": a.pane.target,
                "active": a.pane.active,
            },
            "session_id": a.session_id,
            "active_seconds": int(max(0, time.time() - a.activity)) if a.activity else None,
            "confirmed": a.confirmed,
        }
        for a in agents
    ], indent=2, ensure_ascii=False)


# --------------------------------------------------------------------------
# search
# --------------------------------------------------------------------------

def fold_text(text: str) -> str:
    """Lowercase and strip diacritics, so ``sincronizacion`` finds
    ``Sincronización``."""
    decomposed = unicodedata.normalize("NFKD", text)
    plain = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
    return plain.casefold()


def searchable_text(agent: Agent) -> str:
    return fold_text(" ".join([
        agent.name, agent.kind, agent.status, agent.pane.target,
        agent.pane.session, agent.pane.path, short_path(agent.pane.path),
    ]))


def agent_matches(agent: Agent, query: str) -> bool:
    """Every whitespace-separated term must appear somewhere in the row."""
    haystack = searchable_text(agent)
    terms = fold_text(query).split()
    return all(term in haystack for term in terms)


# --------------------------------------------------------------------------
# interactive picker
# --------------------------------------------------------------------------

class Picker:
    def __init__(self, opencode: OpenCodeIndex, claude: ClaudeIndex, interval: float = 1.0):
        self.opencode = opencode
        self.claude = claude
        self.interval = interval
        self.all_agents: list[Agent] = []
        self.agents: list[Agent] = []
        self.cursor = 0
        self.selected_pane = ""
        self.query = ""
        self.searching = False
        self.pane_before_search = ""
        self.color = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
        self.frame = 0

    # -- terminal ------------------------------------------------------
    def enter(self) -> None:
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        self.raw = True
        tty.setraw(self.fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[2J")
        sys.stdout.flush()

    def leave(self) -> None:
        if not getattr(self, "raw", False):
            return
        self.raw = False
        sys.stdout.write("\x1b[?7h\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        try:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        except termios.error:
            pass

    # -- data ----------------------------------------------------------
    def apply_filter(self) -> None:
        query = self.query.strip()
        if query:
            self.agents = [a for a in self.all_agents if agent_matches(a, query)]
        else:
            self.agents = list(self.all_agents)
        self.cursor = max(0, min(self.cursor, len(self.agents) - 1))

    def refresh(self) -> None:
        self.all_agents = collect(self.opencode, self.claude)
        self.apply_filter()
        if self.selected_pane:
            for i, a in enumerate(self.agents):
                if a.pane.pane_id == self.selected_pane:
                    self.cursor = i
                    break
        if self.agents:
            self.selected_pane = self.agents[self.cursor].pane.pane_id

    def edit_search(self, query: str) -> None:
        self.query = query
        self.apply_filter()
        self.cursor = 0
        self.selected_pane = self.agents[0].pane.pane_id if self.agents else ""

    def start_search(self) -> None:
        self.pane_before_search = (
            self.agents[self.cursor].pane.pane_id if self.agents else ""
        )
        self.searching = True
        self.edit_search("")

    def cancel_search(self) -> None:
        self.searching = False
        self.edit_search("")
        if self.pane_before_search:
            for i, a in enumerate(self.agents):
                if a.pane.pane_id == self.pane_before_search:
                    self.cursor = i
                    break
        if self.agents:
            self.selected_pane = self.agents[self.cursor].pane.pane_id

    # -- drawing -------------------------------------------------------
    def paint(self, text: str, code: str) -> str:
        return f"{code}{text}{RESET}" if self.color else text

    def draw(self) -> None:
        width, height = shutil.get_terminal_size((100, 30))
        # Never write in the last column: a full-width line makes the
        # terminal wrap and the whole frame slides down.
        if width < 50:
            self.color = False
        budget = max(20, width - 1)
        now = time.time()
        working = sum(1 for a in self.agents if a.status == "working")
        waiting = sum(1 for a in self.agents if a.status == "awaiting")
        question = sum(1 for a in self.agents if a.status == "question")
        approval = sum(1 for a in self.agents if a.status == "approval")

        title = "sessions-ls"
        header = self.paint(title, BOLD) if self.color else title
        if self.query:
            summary = f"{len(self.agents)}/{len(self.all_agents)} agents"
        else:
            summary = f"{len(self.agents)} agents"
        plain_bits, color_bits = [], []
        for count, label in ((working, "working"), (waiting, "awaiting"),
                             (question, "question"), (approval, "approval")):
            if count:
                text = f"{count} {label}" + ("s" if label == "question" and count > 1 else "")
                plain_bits.append(text)
                color_bits.append(self.paint(text, STATUS_COLORS[label]))
        clock = f"updated {time.strftime('%H:%M:%S')}"
        if plain_bits:
            full_plain = f"{summary}  ·  " + "  ·  ".join(plain_bits)
            if len(f"  {title}   {full_plain}") + len(clock) + 2 <= budget:
                summary = f"{summary}  ·  " + "  ·  ".join(color_bits)
                summary_plain = full_plain
            else:
                summary_plain = summary
        else:
            summary_plain = summary

        left_visible = f"  {title}   {summary_plain}"
        if cell_width(left_visible) + cell_width(clock) + 2 > budget:
            lines = [truncate(left_visible, budget)]
        else:
            gap = max(1, budget - cell_width(left_visible) - cell_width(clock) - 1)
            lines = [f"  {header}   {summary}" + " " * gap
                     + self.paint(clock, DIM)]
        rule = self.paint("─" * budget, DIM)
        lines.append(rule)

        # Fixed columns: hotkey, cursor, status glyph and status, then the
        # agent kind and age when there is room. On a narrow terminal the
        # status is abbreviated (working -> wor) instead of being cut in the
        # middle, and the kind/age columns go first.
        if budget >= 66:
            show_kind, show_age, status_w = True, True, 8
        elif budget >= 50:
            show_kind, show_age, status_w = False, True, 3
        else:
            show_kind, show_age, status_w = False, False, 3
        target_w = 12 if budget >= 50 else 10
        base = 7 + status_w + (9 if show_kind else 0) + (5 if show_age else 0) \
            + target_w + 2
        name_w = max(6, min(40, budget - base - 12))
        visible = max(1, height - 5)
        if len(self.agents) > visible:
            start = max(0, min(self.cursor - visible // 2,
                               len(self.agents) - visible))
            window = self.agents[start:start + visible]
        else:
            start, window = 0, self.agents

        for i, a in enumerate(window):
            idx = start + i
            selected = idx == self.cursor
            hot = HOTKEYS[idx] if idx < len(HOTKEYS) else " "
            mark = "❯" if selected else " "
            if a.status == "working":
                glyph = SPINNER[self.frame % len(SPINNER)]
            elif a.status == "approval":
                glyph = "!"
            elif a.status == "question":
                glyph = "?"
            elif a.status == "awaiting":
                glyph = "○"
            else:
                glyph = "?"

            label = a.status if status_w >= 8 else \
                STATUS_SHORT.get(a.status, a.status[:status_w])
            status = pad(label, status_w)
            if self.color:
                status = STATUS_COLORS.get(a.status, "") + status + RESET
            kind = a.kind.ljust(8)
            age = human_age(a.activity, now).rjust(4)
            target = pad(truncate(a.pane.target, target_w), target_w)
            name = pad(truncate(a.name, name_w), name_w)
            path = short_path(a.pane.path)

            hot_text = hot if selected or hot == " " else self.paint(hot, DIM)
            line = f" {hot_text} {mark} {glyph} {status}"
            if show_kind:
                line += f" {kind}"
            if show_age:
                line += f" {age}"
            line += f"  {target} {name}"
            room = budget - cell_width(strip_ansi(line)) - 2
            if room > 10:
                line += "  " + self.paint(truncate(path, room), DIM)
            if selected and self.color:
                # Highlight the whole row, including the padding, so no
                # leftover background survives when the cursor moves away.
                plain_line = strip_ansi(line).rstrip()
                line = "\x1b[7m" + pad(plain_line, budget) + RESET
            else:
                line = line.rstrip()
            lines.append(line)

        if not self.agents:
            if self.query:
                lines.append(f"  no matches for /{truncate(self.query, budget - 18)}")
            else:
                lines.append("  no running opencode/claude panes found")

        lines.append(rule)
        if self.searching:
            label = f"  /{self.query}"
            full = "   1-0 pick   ⏎ jump   esc cancel   ⌫ erase"
            short = "   ⏎ jump   esc cancel"
            if cell_width(label) + cell_width(full) <= budget:
                tail = full
            elif cell_width(label) + cell_width(short) <= budget:
                tail = short
            else:
                tail = ""
            if cell_width(label) > budget:
                label = "  /" + truncate_left(self.query, budget - 3)
            lines.append(self.paint(label, BOLD) + self.paint(tail, DIM))
        else:
            target = self.agents[self.cursor].pane.target if self.agents else ""
            jump = f"⏎ jump{f' to {target}' if target else ''}"
            hints = (
                f"  ↑↓/jk move   {jump}   1-0 pick   / search   "
                f"g/G top/bottom   r resort   q quit",
                f"  ↑↓/jk move   {jump}   1-0 pick   / search   g/G   r   q quit",
                "  ↑↓/jk  ⏎ jump  1-0  / search  q quit",
            )
            hint = hints[-1]
            for candidate in hints:
                if cell_width(candidate) <= budget:
                    hint = candidate
                    break
            lines.append(truncate(hint, budget))

        # Pad every row to the last usable column: a row that shrinks must
        # erase whatever the previous frame left there.
        rendered = []
        for line in lines:
            visible = strip_ansi(line)
            if cell_width(visible) > budget:
                line = truncate(visible, budget)
                visible = line
            rendered.append(
                line + " " * max(0, budget - cell_width(visible)) + "\x1b[K"
            )
        sys.stdout.write("\x1b[H" + "\r\n".join(rendered) + "\x1b[J")
        sys.stdout.flush()
        self.frame += 1

    # -- keys ----------------------------------------------------------
    def read_keys(self, timeout: float) -> list[str]:
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return []
        data = os.read(self.fd, 64).decode("utf-8", "replace")
        if data == "\x1b":
            # A lone ESC may be the start of a split escape sequence.
            r, _, _ = select.select([self.fd], [], [], 0.02)
            if r:
                data += os.read(self.fd, 64).decode("utf-8", "replace")
        keys: list[str] = []
        i = 0
        while i < len(data):
            ch = data[i]
            if ch == "\x1b":
                rest = data[i + 1:]
                for seq, key in (("[A", "up"), ("[B", "down"), ("OA", "up"),
                                 ("OB", "down"), ("[H", "home"), ("[F", "end")):
                    if rest.startswith(seq):
                        keys.append(key)
                        i += 1 + len(seq)
                        break
                else:
                    keys.append("esc")
                    i += 1
                continue
            if ch in "\r\n":
                keys.append("enter")
            elif ch == "\x03":
                keys.append("quit")
            else:
                keys.append(ch)
            i += 1
        return keys

    def jump(self, agent: Agent) -> None:
        pane = agent.pane
        if os.environ.get("TMUX"):
            tmux("switch-client", "-t", pane.pane_id)
            tmux("select-window", "-t", f"{pane.session}:{pane.window}")
            tmux("select-pane", "-t", pane.pane_id)
        else:
            subprocess.run(["tmux", "attach-session", "-t", pane.session])

    def run(self) -> int:
        self.enter()
        target: Agent | None = None
        try:
            self.refresh()
            self.draw()
            while True:
                keys = self.read_keys(self.interval)
                if not keys:
                    self.refresh()
                    self.draw()
                    continue
                jump = False
                quit_ = False
                for key in keys:
                    if key == "quit":
                        quit_ = True
                        break
                    if self.searching:
                        if key == "esc":
                            self.cancel_search()
                        elif key == "enter":
                            if self.agents:
                                target = self.agents[self.cursor]
                                self.searching = False
                                self.query = ""
                                jump = True
                                break
                        elif key in ("up", "down") and self.agents:
                            step = -1 if key == "up" else 1
                            self.cursor = (self.cursor + step) % len(self.agents)
                            self.selected_pane = \
                                self.agents[self.cursor].pane.pane_id
                        elif key in ("\x7f", "\x08"):
                            self.edit_search(self.query[:-1])
                        elif key == "\x15":  # C-u
                            self.edit_search("")
                        elif key in HOTKEYS and HOTKEYS.index(key) < len(self.agents):
                            # The number follows the filtered list: 3 jumps to
                            # the third row of what is on screen right now.
                            self.cursor = HOTKEYS.index(key)
                            target = self.agents[self.cursor]
                            self.searching = False
                            self.query = ""
                            jump = True
                            break
                        elif len(key) == 1 and key >= " ":
                            self.edit_search(self.query + key)
                        continue
                    if key in ("q", "esc"):
                        quit_ = True
                        break
                    if key == "/":
                        self.start_search()
                        continue
                    if not self.agents:
                        continue
                    if key in HOTKEYS and HOTKEYS.index(key) < len(self.agents):
                        self.cursor = HOTKEYS.index(key)
                        target = self.agents[self.cursor]
                        jump = True
                        break
                    if key in ("up", "k"):
                        self.cursor = (self.cursor - 1) % len(self.agents)
                    elif key in ("down", "j"):
                        self.cursor = (self.cursor + 1) % len(self.agents)
                    elif key in ("home", "g"):
                        self.cursor = 0
                    elif key in ("end", "G"):
                        self.cursor = len(self.agents) - 1
                    elif key == "r":
                        self.selected_pane = ""
                        self.refresh()
                    elif key == "enter":
                        target = self.agents[self.cursor]
                        jump = True
                        break
                    if self.agents:
                        self.selected_pane = \
                            self.agents[self.cursor].pane.pane_id
                if quit_ or jump:
                    break
                self.draw()
        finally:
            self.leave()
        if target is not None:
            self.jump(target)
        return 0


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog=os.path.basename(sys.argv[0]) or "sessions-ls",
        description="List terminal coding agents running in tmux panes and jump to them.",
    )
    parser.add_argument("--plain", "-l", action="store_true",
                        help="print the list and exit (like ls -lht)")
    parser.add_argument("--json", action="store_true", help="print JSON and exit")
    parser.add_argument("--header", action="store_true",
                        help="print a header row in plain mode")
    parser.add_argument("--watch", "-w", type=float, metavar="SECONDS",
                        help="plain mode: reprint the list every N seconds")
    parser.add_argument("--interval", type=float, default=1.0, metavar="SECONDS",
                        help="interactive refresh interval (default: 1s)")
    parser.add_argument("--version", action="version", version=f"sessions-ls {VERSION}")
    parser.add_argument("extra", nargs="*", help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    if not shutil.which("tmux"):
        print("sessions-ls: tmux not found", file=sys.stderr)
        return 1
    if not tmux("list-panes", "-a", "-F", "#{pane_id}").strip():
        print("sessions-ls: no tmux server running", file=sys.stderr)
        return 1

    opencode = OpenCodeIndex()
    claude = ClaudeIndex()

    interactive = (
        not args.plain and not args.json and not args.watch
        and sys.stdin.isatty() and sys.stdout.isatty()
    )

    if interactive:
        interval = max(0.05, args.interval)
        return Picker(opencode, claude, interval).run()

    if args.json:
        print(as_json(collect(opencode, claude)))
        return 0

    if args.watch:
        try:
            while True:
                text = plain(collect(opencode, claude), header=args.header)
                if sys.stdout.isatty():
                    sys.stdout.write("\x1b[H\x1b[J")
                print(text, flush=True)
                time.sleep(args.watch)
        except KeyboardInterrupt:
            return 0

    text = plain(collect(opencode, claude), header=args.header)
    if text:
        print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
